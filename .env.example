# Copy to .env and edit. NEVER share this file or commit it anywhere.
# This password unlocks gnome-keyring inside the container. It is NOT your
# Xiaomi password. Pick a long random one and keep it in a password manager.
# It must stay the same forever: change it and the stored master key can no
# longer be unlocked, so all devices + HomeKit pairing must be redone.
MIJIALAN_KEYRING_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD

# Xiaomi region for QR-code import: cn / de / us / sg / ru / i2
MIJIALAN_REGION=cn
